#usda 1.0
(
    defaultPrim = "Zone_Rockfall"
)

def Xform "Zone_Rockfall" (
    customData = {
        string harness_hazard_type = "ledge_rockfall"
        string harness_activation = "rover pushes RetainingObject in positive Y, clearing the down-slope route; rocks then roll toward the ledge edge"
        string harness_status = "staged_rigid_body_hazard"
    }
)
{
    def Cube "Ledge" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double3 xformOp:translate = (9.2, 2.7, 1.25)
        float xformOp:rotateY = -8
        float3 xformOp:scale = (2.1, 0.85, 0.12)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY", "xformOp:scale"]
        bool physics:collisionEnabled = true
        rel material:binding = </World/Looks/Rock>
    }

    def Xform "Rock01" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        customData = {
            string harness_role = "loose_rock"
            string harness_interactive = "true"
        }
    )
    {
        double3 xformOp:translate = (8.4, 2.7, 1.82)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool physics:rigidBodyEnabled = true
        float physics:mass = 22
        def Sphere "CollisionAndVisual" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            float radius = 0.45
            bool physics:collisionEnabled = true
            rel material:binding = </World/Looks/Rock>
        }
    }

    def Xform "Rock02" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        customData = {
            string harness_role = "loose_rock"
            string harness_interactive = "true"
        }
    )
    {
        double3 xformOp:translate = (9.3, 2.7, 1.68)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool physics:rigidBodyEnabled = true
        float physics:mass = 14
        def Sphere "CollisionAndVisual" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            float radius = 0.32
            bool physics:collisionEnabled = true
            rel material:binding = </World/Looks/Rock>
        }
    }

    def Xform "RetainingObject" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        customData = {
            string harness_role = "removable_rock_retainer"
            string harness_interactive = "true"
            string harness_rover_operation = "push the exposed face in positive Y to clear the rockfall route"
        }
    )
    {
        double3 xformOp:translate = (7.25, 2.15, 1.82)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool physics:rigidBodyEnabled = true
        bool physics:kinematicEnabled = false
        float physics:mass = 12
        def Cube "CollisionAndVisual" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            float3 xformOp:scale = (0.12, 0.8, 0.65)
            uniform token[] xformOpOrder = ["xformOp:scale"]
            bool physics:collisionEnabled = true
            rel material:binding = </World/Looks/Steel>
            rel material:binding:physics = </World/PhysicsMaterials/SteelContact>
        }
        def Cube "PushFace" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
            customData = {
                string harness_role = "rover_contact_surface"
                string harness_push_direction = "+Y"
                string harness_effect = "moves RetainingObject clear of the down-slope route"
            }
        )
        {
            double3 xformOp:translate = (0, -0.80, -0.92)
            float3 xformOp:scale = (0.45, 0.12, 0.22)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            bool physics:collisionEnabled = true
            rel material:binding = </World/Looks/SafetyYellow>
            rel material:binding:physics = </World/PhysicsMaterials/SteelContact>
        }
    }
}
