#usda 1.0

def Xform "World"
{
    def Scope "Lighting" (
        customData = {
            string harness_role = "lighting"
            string harness_lighting_intent = "warm industrial lamps with cool fill for motion readability"
        }
    )
    {
        def DomeLight "AmbientFill"
        {
            color3f inputs:color = (0.22, 0.26, 0.32)
            float inputs:intensity = 0.75
        }

        def DistantLight "CoolFill"
        {
            color3f inputs:color = (0.34, 0.42, 0.55)
            float inputs:intensity = 350
            float angle = 1
            float3 xformOp:rotateXYZ = (25, -20, -35)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }

        def SphereLight "RoofSupportLamp"
        {
            color3f inputs:color = (1, 0.52, 0.18)
            float inputs:intensity = 8500
            float inputs:radius = 0.24
            double3 xformOp:translate = (3.5, -1.6, 3.55)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def SphereLight "DebrisLamp"
        {
            color3f inputs:color = (1, 0.46, 0.14)
            float inputs:intensity = 6200
            float inputs:radius = 0.20
            double3 xformOp:translate = (-3, -1.7, 3.45)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def SphereLight "RockfallLamp"
        {
            color3f inputs:color = (0.58, 0.72, 1)
            float inputs:intensity = 5200
            float inputs:radius = 0.18
            double3 xformOp:translate = (8.5, 1.3, 3.35)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def SphereLight "EntryLamp"
        {
            color3f inputs:color = (1, 0.58, 0.24)
            float inputs:intensity = 7000
            float inputs:radius = 0.22
            double3 xformOp:translate = (-5.5, -0.5, 3.55)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def SphereLight "TunnelLamp"
        {
            color3f inputs:color = (1, 0.52, 0.18)
            float inputs:intensity = 6500
            float inputs:radius = 0.20
            double3 xformOp:translate = (12.5, 0.4, 3.55)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def SphereLight "RoofSupportZoneLamp"
        {
            color3f inputs:color = (1, 0.55, 0.18)
            float inputs:intensity = 8500
            float inputs:radius = 0.24
            double3 xformOp:translate = (24, -1.6, 3.6)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def SphereLight "RockfallZoneLamp"
        {
            color3f inputs:color = (0.60, 0.72, 1)
            float inputs:intensity = 7800
            float inputs:radius = 0.22
            double3 xformOp:translate = (35, 0.8, 3.55)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def SphereLight "DebrisCascadeZoneLamp"
        {
            color3f inputs:color = (1, 0.48, 0.14)
            float inputs:intensity = 7600
            float inputs:radius = 0.22
            double3 xformOp:translate = (44, -0.8, 3.55)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "VisibleFixtures"
        {
            def Sphere "FixtureEntry"
            {
                double3 xformOp:translate = (-5.5, -0.5, 3.55)
                uniform token[] xformOpOrder = ["xformOp:translate"]
                float radius = 0.16
                rel material:binding = </World/Looks/LampGlow>
            }
            def Sphere "FixtureRoofSupport"
            {
                double3 xformOp:translate = (3.5, -1.6, 3.55)
                uniform token[] xformOpOrder = ["xformOp:translate"]
                float radius = 0.16
                rel material:binding = </World/Looks/LampGlow>
            }
            def Sphere "FixtureDebris"
            {
                double3 xformOp:translate = (-3, -1.7, 3.45)
                uniform token[] xformOpOrder = ["xformOp:translate"]
                float radius = 0.14
                rel material:binding = </World/Looks/LampGlow>
            }
            def Sphere "FixtureRockfall"
            {
                double3 xformOp:translate = (8.5, 1.3, 3.35)
                uniform token[] xformOpOrder = ["xformOp:translate"]
                float radius = 0.13
                rel material:binding = </World/Looks/LampGlow>
            }
            def Sphere "FixtureTunnel"
            {
                double3 xformOp:translate = (12.5, 0.4, 3.55)
                uniform token[] xformOpOrder = ["xformOp:translate"]
                float radius = 0.14
                rel material:binding = </World/Looks/LampGlow>
            }
            def Sphere "FixtureRoofSupportZone"
            {
                double3 xformOp:translate = (24, -1.6, 3.6)
