#usda 1.0

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "Rock"
        {
            token outputs:surface.connect = </World/Looks/Rock/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.22, 0.18, 0.14)
                float inputs:metallic = 0
                float inputs:roughness = 0.92
                color3f inputs:emissiveColor = (0.004, 0.003, 0.002)
                token outputs:surface
            }
        }

        def Material "Concrete"
        {
            token outputs:surface.connect = </World/Looks/Concrete/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.19, 0.20, 0.19)
                float inputs:roughness = 0.82
                token outputs:surface
            }
        }

        def Material "Steel"
        {
            token outputs:surface.connect = </World/Looks/Steel/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.17, 0.20, 0.20)
                float inputs:metallic = 0.82
                float inputs:roughness = 0.42
                token outputs:surface
            }
        }

        def Material "SafetyYellow"
        {
            token outputs:surface.connect = </World/Looks/SafetyYellow/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.52, 0.05)
                float inputs:metallic = 0.15
                float inputs:roughness = 0.43
                token outputs:surface
            }
        }

        def Material "RobotBlue"
        {
            token outputs:surface.connect = </World/Looks/RobotBlue/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.04, 0.22, 0.62)
                float inputs:metallic = 0.4
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "LampGlow"
        {
            token outputs:surface.connect = </World/Looks/LampGlow/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0.55, 0.16)
                color3f inputs:emissiveColor = (3, 1.15, 0.2)
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
    }
}
