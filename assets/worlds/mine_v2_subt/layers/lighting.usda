#usda 1.0

def Xform "World"
{
    def Scope "Lighting" (
        customData = {
            string harness_role = "neutral_rtx_lighting"
            string harness_note = "Authored for Isaac RTX; no Gazebo light was copied."
        }
    )
    {
        def DomeLight "LowAmbient"
        {
            color3f inputs:color = (0.32, 0.36, 0.42)
            float inputs:intensity = 0.9
        }

        def DistantLight "NeutralFill"
        {
            color3f inputs:color = (0.58, 0.66, 0.78)
            float inputs:intensity = 500
            float angle = 1.5
            float3 xformOp:rotateXYZ = (28, -18, -32)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }

        def SphereLight "ApproachFill"
        {
            color3f inputs:color = (0.82, 0.88, 1.0)
            float inputs:intensity = 11000
            float inputs:radius = 0.28
            double3 xformOp:translate = (18, -1.8, 3.8)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def SphereLight "FailureBayKey"
        {
            color3f inputs:color = (1.0, 0.84, 0.66)
            float inputs:intensity = 16000
            float inputs:radius = 0.30
            double3 xformOp:translate = (24, -1.8, 3.8)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def SphereLight "JunctionFill"
        {
            color3f inputs:color = (0.72, 0.82, 1.0)
            float inputs:intensity = 9000
            float inputs:radius = 0.24
            double3 xformOp:translate = (30, 1.4, 3.6)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
