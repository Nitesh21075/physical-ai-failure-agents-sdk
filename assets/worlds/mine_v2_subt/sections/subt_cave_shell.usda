#usda 1.0
(
    defaultPrim = "SubTCaveShell"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "SubTCaveShell" (
    customData = {
        string harness_role = "static_subt_perception_shell"
        string harness_source = "LTU DARPA SubT cave_world OBJ at pinned commit a15a1107e638eae090335d2d6f36c623439aaa7f"
        string harness_collision_policy = "Imported mesh is visual-only in v2 prototype; bounded experiment route uses simple static proxy collision."
    }
)
{
    def Xform "ImportedVisual" (
        references = @../vendor/ltu_darpa_subt/cave_world.usdc@
    )
    {
        # Match the source SDF link pose and world placement.  Physics and
        # lighting from Gazebo are intentionally not imported.
        double3 xformOp:translate = (6.43376, -21.2842, 0)
        float3 xformOp:rotateXYZ = (90, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Cube "ExperimentRouteFloor" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
        customData = {
            string harness_role = "simplified_static_collision_route"
            string harness_extent = "x=8..40m, y=-4..4m"
        }
    )
    {
        double3 xformOp:translate = (24, 0, -0.25)
        float3 xformOp:scale = (16, 4, 0.25)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        bool physics:collisionEnabled = true
        rel material:binding = </World/Looks/Concrete>
        rel material:binding:physics = </World/PhysicsMaterials/RoughConcrete>
    }
}
